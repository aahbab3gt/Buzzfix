# BuzzFix Environment Variables
PORT=3000

# Gemini API Key (get free from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Twilio (required for status-update texts; inbound webhook replies work without it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Demo reset endpoint key (POST /api/admin/reset?key=...)
ADMIN_KEY=buzz

# Set to 1 to turn off duplicate merging entirely during a demo
DISABLE_DEDUPE=0
